# Public link to the Google Doc that holds the "Zero Latency" article.
# Accepted formats:
#   - https://docs.google.com/document/d/<DOC_ID>/edit
#   - https://docs.google.com/document/d/e/<PUBLISHED_ID>/pub   (File > Share > Publish to web)
#   - any direct URL that returns the exported HTML
# The document must be viewable by "anyone with the link".
GOOGLE_DOC_URL=

# Optional: override the export format URL fetched from a /document/d/<ID> link.
# Defaults to the HTML export endpoint.

# Kickstarter campaign link shown in the closing call-to-action block.
NEXT_PUBLIC_KICKSTARTER_URL=https://www.kickstarter.com/
