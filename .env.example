# ── Article content ──────────────────────────────────────────────────────────
# Public link to the Google Doc that holds the "Zero Latency" article.
# Accepted formats:
#   - https://docs.google.com/document/d/<DOC_ID>/edit
#   - https://docs.google.com/document/d/e/<PUBLISHED_ID>/pub   (File > Share > Publish to web)
#   - any direct URL that returns the exported HTML
# The document must be viewable by "anyone with the link".
GOOGLE_DOC_URL=

# ── Backer / donor pledges ───────────────────────────────────────────────────
# Public-key encryption (X25519). The app holds ONLY the public key and can
# encrypt pledges but never decrypt them. Generate a keypair locally:
#   openssl genpkey -algorithm X25519 -out pledge_private.pem
#   openssl pkey -in pledge_private.pem -pubout -out pledge_public.pem
# Then store the PUBLIC key here (raw PEM, or single-line: `base64 -i pledge_public.pem`).
PLEDGE_PUBLIC_KEY=

# The PRIVATE key must NEVER be deployed. Keep pledge_private.pem offline and use
# it only with the local decrypt tool (`npm run decrypt -- --key pledge_private.pem`).
# You may instead point the tool at it via PLEDGE_PRIVATE_KEY_FILE / PLEDGE_PRIVATE_KEY,
# but do not set these in the deployed environment.

# Vercel Blob (the pledge "database"). Provided automatically when you connect a
# Blob store to the project on Vercel; set locally to test against real Blob.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Optional: where to write encrypted pledge files during local development when
# BLOB_READ_WRITE_TOKEN is not set. Defaults to ./.data/pledges
# PLEDGE_LOCAL_DIR=
